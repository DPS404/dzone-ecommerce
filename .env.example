# Required: Neon / Prisma Postgres pooled connection URL (SSL enabled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Required: generate with `openssl rand -base64 48` or Node crypto
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS"
# Required for seed and admin:create scripts. Remove from Vercel once setup is complete.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: one PUBLIC Blob store for product images
BLOB_PUBLIC_READ_WRITE_TOKEN=""
# Optional: separate PRIVATE Blob store for bank-transfer receipt evidence
BLOB_PRIVATE_READ_WRITE_TOKEN=""
# Optional mail delivery: SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DZone <orders@example.com>"
